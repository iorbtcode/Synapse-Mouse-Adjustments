<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- MIDNIGHT palette: near-black surfaces, white for active/enabled, dim gray for disabled. -->
    <Color x:Key="Color.Background">#07080A</Color>
    <Color x:Key="Color.Sidebar">#0B0C0F</Color>
    <Color x:Key="Color.Panel">#111317</Color>
    <Color x:Key="Color.PanelRaised">#16181D</Color>
    <Color x:Key="Color.Input">#1A1D22</Color>
    <Color x:Key="Color.InputHover">#21252B</Color>
    <Color x:Key="Color.Border">#1F2228</Color>
    <Color x:Key="Color.BorderStrong">#2E323A</Color>
    <Color x:Key="Color.Text">#FFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#A3A9B4</Color>
    <Color x:Key="Color.TextDim">#5C616B</Color>
    <Color x:Key="Color.Accent">#FFFFFF</Color>
    <Color x:Key="Color.AccentForeground">#07080A</Color>
    <Color x:Key="Color.Track">#2A2E36</Color>
    <Color x:Key="Color.Hover">#1C1F25</Color>
    <Color x:Key="Color.Selected">#23262D</Color>
    <Color x:Key="Color.Note">#D9B36C</Color>
    <Color x:Key="Color.Danger">#FF6B6B</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.PanelRaised" Color="{StaticResource Color.PanelRaised}" />
    <SolidColorBrush x:Key="Brush.Input" Color="{StaticResource Color.Input}" />
    <SolidColorBrush x:Key="Brush.InputHover" Color="{StaticResource Color.InputHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="{StaticResource Color.AccentForeground}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />
    <SolidColorBrush x:Key="Brush.Note" Color="{StaticResource Color.Note}" />
    <SolidColorBrush x:Key="Brush.NoteBackground" Color="#14D9B36C" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

    <FontFamily x:Key="Font.Main">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Control">7</CornerRadius>
    <sys:Double x:Key="Size.IconStroke">1.6</sys:Double>

    <!-- Navigation / section icons (24×24, drawn as strokes). -->
    <Geometry x:Key="Icon.Dashboard">M3.5,3.5 H10.5 V10.5 H3.5 Z M13.5,3.5 H20.5 V10.5 H13.5 Z M3.5,13.5 H10.5 V20.5 H3.5 Z M13.5,13.5 H20.5 V20.5 H13.5 Z</Geometry>
    <Geometry x:Key="Icon.Mouse">M12,2.5 C8.4,2.5 5.5,5.4 5.5,9 V15 C5.5,18.6 8.4,21.5 12,21.5 C15.6,21.5 18.5,18.6 18.5,15 V9 C18.5,5.4 15.6,2.5 12,2.5 Z M12,6.5 V9.5</Geometry>
    <Geometry x:Key="Icon.Buttons">M12,2.5 C8.4,2.5 5.5,5.4 5.5,9 V15 C5.5,18.6 8.4,21.5 12,21.5 C15.6,21.5 18.5,18.6 18.5,15 V9 C18.5,5.4 15.6,2.5 12,2.5 Z M5.5,10.5 H18.5 M12,2.5 V10.5</Geometry>
    <Geometry x:Key="Icon.Click">M5.5,3.5 L18.5,11.5 L12.2,12.9 L9.4,19.5 Z M13,13.5 L18,19.5</Geometry>
    <Geometry x:Key="Icon.Dpi">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,12 L16.5,7.5 M12,3 V5 M3,12 H5 M19,12 H21</Geometry>
    <Geometry x:Key="Icon.Polling">M2.5,12 H6.5 L9,5 L13.5,19 L16,12 H21.5</Geometry>
    <Geometry x:Key="Icon.Scroll">M12,3 V21 M7.5,7.5 L12,3 L16.5,7.5 M7.5,16.5 L12,21 L16.5,16.5</Geometry>
    <Geometry x:Key="Icon.Configs">M12,3 L21,7.8 L12,12.6 L3,7.8 Z M3,12 L12,16.8 L21,12 M3,16.2 L12,21 L21,16.2</Geometry>
    <Geometry x:Key="Icon.Tester">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M7,12 A5,5 0 1 1 17,12 A5,5 0 1 1 7,12 Z M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z</Geometry>
    <Geometry x:Key="Icon.Settings">M4,6.5 H20 M4,12 H20 M4,17.5 H20 M9,4.5 V8.5 M15,10 V14 M7,15.5 V19.5</Geometry>
    <Geometry x:Key="Icon.Power">M12,3 V11 M7.2,5.8 A8,8 0 1 0 16.8,5.8</Geometry>
    <Geometry x:Key="Icon.Info">M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 Z M12,11 V16.5 M12,7.5 V8</Geometry>
    <Geometry x:Key="Icon.Plus">M12,5 V19 M5,12 H19</Geometry>
    <Geometry x:Key="Icon.Close">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="Icon.Minimize">M5,12 H19</Geometry>
    <Geometry x:Key="Icon.Maximize">M5.5,5.5 H18.5 V18.5 H5.5 Z</Geometry>
    <Geometry x:Key="Icon.Lock">M6.5,11 H17.5 V20 H6.5 Z M8.5,11 V8 A3.5,3.5 0 0 1 15.5,8 V11</Geometry>
    <Geometry x:Key="Icon.Keyboard">M3,6.5 H21 V17.5 H3 Z M6.5,10 H7.5 M10,10 H11 M13.5,10 H14.5 M17,10 H18 M7.5,14 H16.5</Geometry>
    <Geometry x:Key="Icon.Trash">M5,7 H19 M9.5,7 V4.5 H14.5 V7 M7,7 L8,20 H16 L17,7</Geometry>
    <Geometry x:Key="Icon.Check">M5,12.5 L10,17.5 L19,7</Geometry>

</ResourceDictionary>
