<UserControl x:Class="SynapseMouse.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SynapseMouse.App.Controls"
             x:ClassModifier="internal">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,8,36,36">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,22" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="Startup &amp; window" />
                    <c:SettingItem Title="Start with Windows" Description="{Binding StartupNote}" BorderThickness="0">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" />
                    </c:SettingItem>
                    <c:SettingItem Title="Start minimized" Description="Open straight to the system tray whenever Synapse starts.">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartMinimized}" />
                    </c:SettingItem>
                    <c:SettingItem Title="Minimize to tray" Description="The minimize button hides Synapse to the tray. Closing the window (×) always keeps Synapse running in the tray.">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding MinimizeToTray}" />
                    </c:SettingItem>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="Master Enable behavior" />
                    <c:SettingItem Title="When Synapse starts" BorderThickness="0">
                        <ComboBox Width="240" ItemsSource="{Binding StartupOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MasterOnStartup}" />
                    </c:SettingItem>
                    <c:SettingItem Title="Scope" Description="Per-config: switching configs also switches to that config's saved Master Enable state.">
                        <ComboBox Width="280" ItemsSource="{Binding ScopeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MasterScope}" />
                    </c:SettingItem>
                    <c:SettingItem Title="Master Enable hotkey" Description="{Binding MasterHotkeyStatus}">
                        <c:KeyCaptureBox Chord="{Binding MasterToggleHotkey}" Placeholder="Not set" />
                    </c:SettingItem>
                    <c:SettingItem Title="Emergency off" Description="Always turns Master Enable off, even if a remap makes the mouse hard to use. Cannot be changed or remapped.">
                        <Border Padding="12,7" CornerRadius="7" BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}">
                            <TextBlock Text="{Binding EmergencyHotkey}" Style="{StaticResource Text.Mono}" />
                        </Border>
                    </c:SettingItem>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="Notifications &amp; safety" />
                    <c:SettingItem Title="On-screen indicator" Description="Briefly shows DPI, config and Master Enable changes made with hotkeys or mouse buttons." BorderThickness="0">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowOsd}" />
                    </c:SettingItem>
                    <c:SettingItem Title="Tray notifications" Description="Notices such as 'still running in the tray'.">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowTrayNotifications}" />
                    </c:SettingItem>
                    <c:SettingItem Title="Crash protection watchdog" Description="A tiny helper process restores your Windows mouse settings if Synapse is force-closed or crashes. Input hooks are always removed by Windows automatically.">
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding WatchdogEnabled}" />
                    </c:SettingItem>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="Config storage location" Description="{Binding StorageNote}" />
                    <TextBox Text="{Binding StorageLocation, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="12" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open folder" Command="{Binding OpenStorageCommand}" />
                        <Button Content="Change location…" Margin="8,0,0,0" Command="{Binding ChangeStorageCommand}" />
                        <Button Content="Open logs" Margin="8,0,0,0" Command="{Binding OpenLogsCommand}" Style="{StaticResource Button.Ghost}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="Import / export settings"
                                   Description="A .synapsebackup file contains every config, association and app setting." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Export all settings…" Command="{Binding ExportCommand}" />
                        <Button Content="Import settings…" Margin="8,0,0,0" Command="{Binding ImportCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Reset all settings" Style="{StaticResource Text.CardTitle}" />
                        <TextBlock Style="{StaticResource Text.CardSubtitle}"
                                   Text="Removes custom configs, restores defaults, disables all mouse modifications and returns to normal Windows mouse behavior. Asks for confirmation first." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Reset all settings…" Style="{StaticResource Button.Danger}" VerticalAlignment="Center" Command="{Binding ResetAllCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Style="{StaticResource Text.Label}" Margin="0,10,0,0">
                        <Run Text="Synapse Mouse Adjustments" FontWeight="SemiBold" /> <Run Text="{Binding Version, Mode=OneWay, StringFormat='version {0}'}" Foreground="{StaticResource Brush.TextSecondary}" />
                    </TextBlock>
                    <TextBlock Text="{Binding AboutText}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding RuntimeText}" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
