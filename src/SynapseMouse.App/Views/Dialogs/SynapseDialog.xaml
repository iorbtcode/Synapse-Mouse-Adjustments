<Window x:Class="SynapseMouse.App.Views.Dialogs.SynapseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Synapse Mouse Adjustments"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Main}"
        Foreground="{StaticResource Brush.Text}"
        UseLayoutRounding="True">
    <Border Margin="16" Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.BorderStrong}"
            BorderThickness="1" CornerRadius="14" Padding="26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.CardTitle}" FontSize="17" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" Margin="0,10,0,0" FontSize="13" />
            <TextBox x:Name="InputBox" Margin="0,16,0,0" Visibility="Collapsed" MaxLength="40" />
            <ListBox x:Name="ChoiceList" Margin="0,16,0,0" Height="300" Visibility="Collapsed"
                     Background="{StaticResource Brush.Input}" BorderBrush="{StaticResource Brush.BorderStrong}"
                     BorderThickness="1" Padding="4" MouseDoubleClick="OnChoiceDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Item1}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Item2}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="CountdownText" Style="{StaticResource Text.Caption}" Margin="0,14,0,0" Visibility="Collapsed" FontSize="12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="SecondaryButton" Content="Cancel" IsCancel="True" MinWidth="96" Click="OnSecondary" />
                <Button x:Name="PrimaryButton" Content="OK" IsDefault="True" MinWidth="96" Margin="10,0,0,0"
                        Style="{StaticResource Button.Primary}" Click="OnPrimary" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
