<UserControl x:Class="SynapseMouse.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SynapseMouse.App.Controls"
             xmlns:vm="clr-namespace:SynapseMouse.App.ViewModels"
             x:ClassModifier="internal">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,8,36,36">
            <TextBlock Text="Synapse Mouse Adjustments" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,22" />

            <!-- MASTER ENABLE -->
            <Border Style="{StaticResource Card}" Padding="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="54" Height="54" CornerRadius="27" VerticalAlignment="Center" Margin="0,0,20,0"
                            BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}">
                        <c:Icon Data="{StaticResource Icon.Power}" Width="26" Height="26" StrokeThickness="2">
                            <c:Icon.Style>
                                <Style TargetType="c:Icon" BasedOn="{StaticResource {x:Type c:Icon}}">
                                    <Setter Property="Stroke" Value="{StaticResource Brush.Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MasterEnabled}" Value="False">
                                            <Setter Property="Stroke" Value="{StaticResource Brush.TextDim}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </c:Icon.Style>
                        </c:Icon>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="MASTER ENABLE" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding MasterText}" FontFamily="{StaticResource Font.Display}" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MasterEnabled}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding MasterDescription}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Toggle.Large}" IsChecked="{Binding MasterEnabled}"
                              VerticalAlignment="Center" Margin="24,0,0,0" AutomationProperties.Name="Master Enable" />
                </Grid>
            </Border>

            <!-- Status tiles -->
            <UniformGrid Columns="4" Margin="0,0,-12,4">
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="BACKGROUND STATUS" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding BackgroundStatus}" Style="{StaticResource Text.Stat}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding BackgroundDetail}" Style="{StaticResource Text.Body}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="CURRENT CONFIG" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding CurrentConfigName}" Style="{StaticResource Text.Stat}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding AutoSwitchNote}" Style="{StaticResource Text.Body}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE FEATURES" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding ActiveFeatureText}" Style="{StaticResource Text.Stat}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding FeaturesHint}" Style="{StaticResource Text.Body}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="MOUSE" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding MouseStatus}" Style="{StaticResource Text.Stat}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding MouseName}" Style="{StaticResource Text.Body}" FontSize="11.5" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SettingItem Style="{StaticResource CardHeader}" Title="Config" Description="Switch instantly. Config hotkeys work from any app." />
                            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding ConfigOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding SelectedConfigId}" />
                            <Button Content="Manage configs →" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Margin="-10,10,0,0" Command="{Binding OpenPageCommand}" CommandParameter="configs" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SettingItem Style="{StaticResource CardHeader}" Title="DPI" Description="Software DPI stages (the mouse's hardware DPI is unchanged).">
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding DpiStagesEnabled}" ToolTip="Software DPI stages" />
                            </c:SettingItem>
                            <TextBlock Text="{Binding CurrentDpiText}" Style="{StaticResource Text.Stat}" Margin="0,6,0,12" />
                            <Border Style="{StaticResource SegmentHost}" IsEnabled="{Binding DpiStagesEnabled}">
                                <ItemsControl ItemsSource="{Binding Stages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:StageChip}">
                                            <RadioButton Style="{StaticResource Segment}" GroupName="DashboardStages" Content="{Binding Label}"
                                                         IsChecked="{Binding IsActive, Mode=OneWay}" IsEnabled="{Binding IsEnabled}"
                                                         Command="{Binding SelectCommand}" CommandParameter="{Binding Index}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Button Content="DPI &amp; Sensitivity →" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Margin="-10,10,0,0" Command="{Binding OpenPageCommand}" CommandParameter="dpi" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SettingItem Style="{StaticResource CardHeader}" Title="Main click settings" Description="The most-used click options of the current config." />
                            <c:SettingItem Title="Debounce" Description="Software filter for switch bounce." BorderThickness="0">
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding DebounceEnabled}" />
                            </c:SettingItem>
                            <c:NumericSlider Value="{Binding DebounceMs}" Minimum="1" Maximum="100" SliderMaximum="30" Step="1" Unit="ms"
                                             IsEnabled="{Binding DebounceEnabled}" Margin="0,0,0,8" />
                            <c:SettingItem Title="Single → Double click" Description="One physical click sends two clicks.">
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding DoubleClickEnabled}" />
                            </c:SettingItem>
                            <c:NumericSlider Value="{Binding DoubleClickInterval}" Minimum="5" Maximum="500" SliderMaximum="150" Step="1" Unit="ms"
                                             IsEnabled="{Binding DoubleClickEnabled}" />
                            <Button Content="All click settings →" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                    Margin="-10,10,0,0" Command="{Binding OpenPageCommand}" CommandParameter="click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SettingItem Style="{StaticResource CardHeader}" Title="What this config changes" />
                            <ItemsControl ItemsSource="{Binding ActiveFeatures}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <c:Icon Data="{StaticResource Icon.Check}" Width="14" Height="14" Stroke="{StaticResource Brush.TextSecondary}" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding FeaturesHint}" Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                                       Visibility="{Binding FeaturesHint, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource InfoBox}">
                <StackPanel Orientation="Horizontal">
                    <c:Icon Data="{StaticResource Icon.Info}" Width="16" Height="16" Stroke="{StaticResource Brush.TextSecondary}" VerticalAlignment="Top" />
                    <TextBlock Style="{StaticResource Text.Body}" Margin="10,0,0,0" MaxWidth="820">
                        <Run Text="Emergency off:" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" />
                        <Run Text="{Binding EmergencyHotkey, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" />
                        <Run Text="turns Master Enable off from anywhere. Closing this window keeps Synapse running in the tray — choose Exit in the tray menu to quit." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
