<UserControl x:Class="SynapseMouse.App.Views.TesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SynapseMouse.App.Controls"
             xmlns:vm="clr-namespace:SynapseMouse.App.ViewModels"
             x:ClassModifier="internal">
    <UserControl.Resources>
        <Style x:Key="Led" TargetType="Ellipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stroke" Value="{StaticResource Brush.BorderStrong}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Fill" Value="{StaticResource Brush.Input}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,8,36,36">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,4,160,22" />
                </StackPanel>
                <Button Content="Clear" Command="{Binding ClearCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0" />
            </Grid>

            <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Label}" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <c:SettingItem Style="{StaticResource CardHeader}" Title="Buttons" Description="Lit while held. MOUSE = what the mouse sent, WINDOWS = what apps received after Synapse." />
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="MOUSE" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="WINDOWS" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="PRESSES (MOUSE / WINDOWS)" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Buttons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ButtonStateItem}">
                                    <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Ellipse Grid.Column="1">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PhysicalDown}" Value="True">
                                                                <Setter Property="Fill" Value="#8C929C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Ellipse Grid.Column="2">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse" BasedOn="{StaticResource Led}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OutputDown}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="3" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Run Text="{Binding PhysicalPresses, Mode=OneWay}" Foreground="{StaticResource Brush.TextSecondary}" /><Run Text=" / " Foreground="{StaticResource Brush.TextDim}" /><Run Text="{Binding OutputPresses, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <c:SettingItem Style="{StaticResource CardHeader}" Title="Test pad" Description="Click, double-click and scroll here." />
                            <Border x:Name="Pad" Height="120" CornerRadius="10" Background="{StaticResource Brush.Input}" Margin="0,6,0,0"
                                    BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" MouseDown="OnPadMouseDown" Cursor="Cross">
                                <TextBlock Text="Double-click me" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Border>
                            <TextBlock Text="{Binding DoubleClickText}" Style="{StaticResource Text.Body}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Click timing" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="LEFT" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding LeftTiming}" Style="{StaticResource Text.Mono}" FontSize="12" />
                            <TextBlock Text="RIGHT" Style="{StaticResource Text.Caption}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding RightTiming}" Style="{StaticResource Text.Mono}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Event timeline — last 3 seconds" Style="{StaticResource Text.CardTitle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Rectangle Width="18" Height="6" RadiusX="2" RadiusY="2" Fill="#6B717C" VerticalAlignment="Center" />
                            <TextBlock Text="From the mouse" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="6,0,16,0" />
                            <Rectangle Width="18" Height="6" RadiusX="2" RadiusY="2" Fill="White" VerticalAlignment="Center" />
                            <TextBlock Text="Received by Windows" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <c:InputTimeline x:Name="Timeline" Height="230" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Scroll &amp; movement" Style="{StaticResource Text.CardTitle}" />
                    <c:SettingItem Title="Scroll" Description="{Binding WheelText}" BorderThickness="0" />
                    <c:SettingItem Title="Movement" Description="{Binding MovementText}" />
                    <c:SettingItem Title="Cursor position">
                        <TextBlock Text="{Binding CursorText}" Style="{StaticResource Text.Mono}" />
                    </c:SettingItem>
                    <TextBlock Text="{Binding FilterText}" Style="{StaticResource Text.Body}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Event log" Style="{StaticResource Text.CardTitle}" />
                    <ListBox ItemsSource="{Binding EventLog}" Height="220" Margin="0,10,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                             Background="{StaticResource Brush.Input}" Padding="6">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6,2" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
