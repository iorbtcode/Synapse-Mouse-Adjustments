<UserControl x:Class="SynapseMouse.App.Views.ButtonsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SynapseMouse.App.Controls"
             xmlns:vm="clr-namespace:SynapseMouse.App.ViewModels"
             x:ClassModifier="internal">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,8,36,36">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,22" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="Mouse buttons"
                                   Description="Each physical button can produce another mouse button, a keyboard key (held while the button is held), or a Synapse function.">
                        <Button Content="Reset mappings" Command="{Binding ResetMappingsCommand}" />
                    </c:SettingItem>
                    <ItemsControl ItemsSource="{Binding ButtonRows}" ItemTemplate="{StaticResource MappingRowTemplate}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding HardwareNote}" Style="{StaticResource Text.Body}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="Scroll wheel"
                                   Description="Each notch triggers the chosen action once. Tilt left/right only exists on mice with a tilting wheel." />
                    <ItemsControl ItemsSource="{Binding WheelRows}" ItemTemplate="{StaticResource MappingRowTemplate}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="Virtual buttons"
                                   Description="No side buttons? Create software buttons: hold a keyboard shortcut and it acts exactly like holding a mouse button (Back, Forward, any mouse button, a key, DPI or config switching).">
                        <Button Command="{Binding AddVirtualButtonCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
                                <TextBlock Text="Add virtual button" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </c:SettingItem>

                    <TextBlock Text="No virtual buttons yet." Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                               Visibility="{Binding VirtualButtons.Count, Converter={StaticResource ZeroToVisible}}" />

                    <ItemsControl ItemsSource="{Binding VirtualButtons}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VirtualButtonViewModel}">
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" ToolTip="Enabled" />
                                            <TextBox Grid.Column="1" Margin="12,0,0,0" Text="{Binding Name}" MaxLength="40" ToolTip="Name" />
                                            <c:KeyCaptureBox Grid.Column="2" Margin="10,0,0,0" Chord="{Binding Trigger}" Placeholder="Set shortcut" ToolTip="Keyboard shortcut that acts as this button" />
                                            <TextBlock Grid.Column="3" Text="→" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextSecondary}"
                                                       VerticalAlignment="Center" Margin="10,0" />
                                            <ComboBox Grid.Column="4" ItemsSource="{Binding Actions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding Action}" />
                                            <c:KeyCaptureBox Grid.Column="5" Margin="10,0,0,0" HorizontalAlignment="Left" AllowModifierOnly="True"
                                                             Chord="{Binding Key}" Placeholder="Key to send"
                                                             Visibility="{Binding IsKeyboard, Converter={StaticResource BoolToVisible}}" />
                                            <Button Grid.Column="6" Style="{StaticResource Button.Icon}" Command="{Binding RemoveCommand}" ToolTip="Remove">
                                                <c:Icon Data="{StaticResource Icon.Trash}" Width="16" Height="16" Stroke="{StaticResource Brush.TextSecondary}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Note}" Margin="52,6,0,0"
                                                   Visibility="{Binding Warning, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoBox}">
                <TextBlock Style="{StaticResource Text.Body}">
                    <Run Text="Remapping works at the Windows input level in every app, including games. Replacement input is sent through the standard Windows SendInput API and is marked as software-generated by Windows, like any remapping tool — Synapse never hides it. If a remap makes the mouse hard to use, press" />
                    <Run Text="{Binding EmergencyHotkey, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" FontWeight="SemiBold" />
                    <Run Text="to turn Master Enable off." />
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
