<UserControl x:Class="SynapseMouse.App.Views.MouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SynapseMouse.App.Controls"
             xmlns:vm="clr-namespace:SynapseMouse.App.ViewModels"
             x:ClassModifier="internal">
    <UserControl.Resources>
        <Style x:Key="Prop" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,16" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,8,36,36">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,22" />

            <Border Style="{StaticResource Card}" Padding="26,22">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="14" Background="{StaticResource Brush.Input}"
                                BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
                            <c:Icon Data="{StaticResource Icon.Mouse}" Width="30" Height="30" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Text.Stat}" FontSize="22" />
                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,3,0,0">
                                <Run Text="●" /> <Run Text="{Binding ConnectionStatus, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                    </Grid>

                    <UniformGrid Columns="3">
                        <StackPanel Style="{StaticResource Prop}">
                            <TextBlock Text="MANUFACTURER" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource Text.Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Prop}">
                            <TextBlock Text="CONNECTION" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding ConnectionType}" Style="{StaticResource Text.Label}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Prop}">
                            <TextBlock Text="VENDOR / PRODUCT ID" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding VendorProduct}" Style="{StaticResource Text.Mono}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Prop}">
                            <TextBlock Text="BUTTONS (REPORTED BY DRIVER)" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding ButtonCount}" Style="{StaticResource Text.Label}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Prop}">
                            <TextBlock Text="HORIZONTAL WHEEL" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding HorizontalWheel}" Style="{StaticResource Text.Label}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Prop}">
                            <TextBlock Text="CURRENT CONFIG" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding ActiveConfig}" Style="{StaticResource Text.Label}" Margin="0,4,0,0" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="DEVICE ID" Style="{StaticResource Text.Caption}" />
                        <TextBox Text="{Binding DeviceId, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                 Margin="0,5,0,0" Background="Transparent" BorderThickness="0" Padding="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="SOFTWARE STATUS" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding SoftwareStatus}" Style="{StaticResource Text.Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Note}" Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Text.Note}">
                    <Run Text="What software can and cannot change:" FontWeight="SemiBold" />
                    <Run Text="a generic office mouse has fixed hardware — its sensor DPI, polling rate and switch debounce are set by its firmware, which Windows cannot modify. Synapse provides software equivalents (software DPI, software debounce, remapping) and labels them as such; it never claims to change the hardware." />
                </TextBlock>
            </Border>

            <Border Style="{StaticResource InfoBox}" Margin="0,0,0,16">
                <TextBlock Text="{Binding SideButtonNote}" Style="{StaticResource Text.Body}" />
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="All pointing devices"
                                   Description="Every mouse-class device Windows reports. Move a mouse while this page is open to mark it as in use." />
                    <ItemsControl ItemsSource="{Binding Devices}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceItem}">
                                <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Text.Body}" Margin="0,3,0,0">
                                                <Run Text="{Binding Connection, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding VendorProduct, Mode=OneWay}" /><Run Text="  ·  Buttons: " /><Run Text="{Binding Buttons, Mode=OneWay}" /><Run Text="  ·  Manufacturer: " /><Run Text="{Binding Manufacturer, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding WindowsDescription, StringFormat='Windows: {0}'}" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="8,3" CornerRadius="9" VerticalAlignment="Center"
                                                BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}"
                                                Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}">
                                            <TextBlock Text="{Binding Badge}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
