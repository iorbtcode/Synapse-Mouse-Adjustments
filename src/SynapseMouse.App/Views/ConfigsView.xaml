<UserControl x:Class="SynapseMouse.App.Views.ConfigsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SynapseMouse.App.Controls"
             xmlns:vm="clr-namespace:SynapseMouse.App.ViewModels"
             x:ClassModifier="internal">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,8,36,36">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.PageSubtitle}" Margin="0,4,0,22" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Config list -->
                <Border Style="{StaticResource Card}" Padding="14,16">
                    <StackPanel>
                        <Grid Margin="8,0,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Your configs" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Width="150" MinWidth="0" ItemsSource="{Binding PresetOptions}" SelectedItem="{Binding NewPreset}"
                                      ToolTip="Preset used for new configs" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding NewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" Stroke="{StaticResource Brush.AccentForeground}" StrokeThickness="2" />
                                    <TextBlock Text="New" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ListBox ItemsSource="{Binding Configs}" SelectedItem="{Binding Selected}" MaxHeight="520">
                            <ListBox.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ActivateCommand}" />
                                <KeyBinding Key="Enter" Command="{Binding ActivateCommand}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConfigItemViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,12,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Track}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" FontSize="12" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Badges}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Hotkey, TargetNullValue=''}" Style="{StaticResource Text.Caption}" FontWeight="Normal" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Double-click a config (or press Enter) to activate it." Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="8,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Selected config -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" IsEnabled="{Binding HasSelection}">
                        <StackPanel DataContext="{Binding Selected}">
                            <TextBlock Text="SELECTED CONFIG" Style="{StaticResource Text.Caption}" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Stat}" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Preset}" Style="{StaticResource Text.Body}" Margin="0,2,0,14" />
                            <Button Content="Activate" Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                            <UniformGrid Columns="2" Margin="0,8,-8,0">
                                <Button Content="Rename" Margin="0,0,8,8" Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="Duplicate" Margin="0,0,8,8" Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="Set as default" Margin="0,0,8,8" Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="Export…" Margin="0,0,8,8" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="Move up" Margin="0,0,8,8" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="Move down" Margin="0,0,8,8" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="Reset" Margin="0,0,8,8" Style="{StaticResource Button.Danger}" Command="{Binding DataContext.ResetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Button Content="Delete" Margin="0,0,8,8" Style="{StaticResource Button.Danger}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </UniformGrid>
                            <TextBlock Text="SWITCH HOTKEY" Style="{StaticResource Text.Caption}" Margin="0,10,0,6" />
                            <c:KeyCaptureBox Chord="{Binding Hotkey}" Placeholder="e.g. Ctrl + Alt + 2" HorizontalAlignment="Stretch" />
                            <TextBlock Text="This shortcut is in use by another app — pick a different one." Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Note}" Margin="0,6,0,0"
                                       Visibility="{Binding HotkeyFailed, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Save &amp; share" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource Text.CardSubtitle}" />
                            <UniformGrid Columns="2" Margin="0,14,-8,0">
                                <Button Content="Save now" Margin="0,0,8,0" Command="{Binding SaveCommand}" />
                                <Button Content="Import config…" Margin="0,0,8,0" Command="{Binding ImportCommand}" />
                            </UniformGrid>
                            <TextBlock Text="Configs are exported as .synapseconfig files. Imported files are validated and always added as a new config."
                                       Style="{StaticResource Text.Body}" FontSize="12" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Application-specific configs -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <c:SettingItem Style="{StaticResource CardHeader}" Title="Application-specific configs"
                                   Description="Activate a config automatically while a chosen application is in the foreground.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Automatic Config Switching" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AutoSwitchEnabled}" />
                        </StackPanel>
                    </c:SettingItem>
                    <c:SettingItem Title="When the app is no longer in the foreground" BorderThickness="0" IsEnabled="{Binding AutoSwitchEnabled}">
                        <ComboBox Width="270" ItemsSource="{Binding FallbackOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Fallback}" />
                    </c:SettingItem>

                    <Grid Margin="0,10,0,6" IsEnabled="{Binding AutoSwitchEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="APPLICATION (.EXE)" Style="{StaticResource Text.Caption}" />
                        <TextBlock Grid.Column="3" Text="WINDOW TITLE CONTAINS (OPTIONAL)" Style="{StaticResource Text.Caption}" />
                        <TextBlock Grid.Column="5" Text="CONFIG" Style="{StaticResource Text.Caption}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Associations}" IsEnabled="{Binding AutoSwitchEnabled}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AssociationViewModel}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" ToolTip="Enabled" />
                                    <TextBox Grid.Column="1" Text="{Binding ProcessName}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" />
                                    <TextBox Grid.Column="3" Text="{Binding WindowTitleContains}" />
                                    <TextBlock Grid.Column="4" Text="→" Style="{StaticResource Text.Label}" Foreground="{StaticResource Brush.TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="5" ItemsSource="{Binding ConfigOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding ConfigId}" MinWidth="0" />
                                    <Button Grid.Column="6" Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Command="{Binding RemoveCommand}" ToolTip="Remove">
                                        <c:Icon Data="{StaticResource Icon.Trash}" Width="16" Height="16" Stroke="{StaticResource Brush.TextSecondary}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No applications linked yet." Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                               Visibility="{Binding Associations.Count, Converter={StaticResource ZeroToVisible}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Add running app…" Command="{Binding AddAssociationCommand}" />
                        <Button Content="Add Minecraft (Java Edition)" Margin="8,0,0,0" Command="{Binding AddMinecraftCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="Normal" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap">
                        <Run Text="Foreground now:" /> <Run Text="{Binding ForegroundText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
