<Window x:Class="SynapseMouse.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SynapseMouse.App.Controls"
        xmlns:v="clr-namespace:SynapseMouse.App.Views"
        xmlns:vm="clr-namespace:SynapseMouse.App.ViewModels"
        x:ClassModifier="internal"
        Title="Synapse Mouse Adjustments"
        Width="1200" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Main}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MouseViewModel}">
            <v:MouseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ButtonsViewModel}">
            <v:ButtonsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClickViewModel}">
            <v:ClickView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DpiViewModel}">
            <v:DpiView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PollingViewModel}">
            <v:PollingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScrollViewModel}">
            <v:ScrollView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigsViewModel}">
            <v:ConfigsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TesterViewModel}">
            <v:TesterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sidebar -->
            <Border Grid.RowSpan="2" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0" />

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Brush.Accent}">
                    <c:Icon Data="{StaticResource Icon.Mouse}" Width="16" Height="16" Stroke="{StaticResource Brush.AccentForeground}" StrokeThickness="2" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="SYNAPSE" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="MOUSE ADJUSTMENTS" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextDim}" />
                </StackPanel>
            </StackPanel>

            <DockPanel Grid.Row="1" LastChildFill="True">
                <!-- Master status at the bottom of the sidebar -->
                <Border DockPanel.Dock="Bottom" Margin="14,8,14,16" Padding="14,12" CornerRadius="10"
                        Background="{StaticResource Brush.Panel}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MASTER" Style="{StaticResource Text.Caption}" />
                            <TextBlock x:Name="SidebarMaster" Text="{Binding MasterText}" FontWeight="SemiBold" FontSize="12.5" Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MasterEnabled}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ConfigName}" Style="{StaticResource Text.Caption}" FontWeight="Normal" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding MasterEnabled}" ToolTip="Master Enable" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding Pages}" KeyboardNavigation.TabNavigation="Continue">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItem}">
                                <RadioButton Style="{StaticResource Nav}" GroupName="Navigation" Content="{Binding Title}"
                                             Tag="{Binding Icon}" IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Title bar (content side) -->
            <Grid Grid.Column="1" Grid.Row="0">
                <TextBlock Text="{Binding AppTitle}" Style="{StaticResource Text.Caption}" FontSize="11.5" VerticalAlignment="Center" Margin="24,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Padding="10,4" CornerRadius="11" VerticalAlignment="Center" Margin="0,0,12,0"
                            BorderThickness="1" BorderBrush="{StaticResource Brush.BorderStrong}">
                        <TextBlock Text="{Binding MasterText}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MasterEnabled}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button Style="{StaticResource Button.Caption}" Click="OnMinimize" ToolTip="Minimize">
                        <c:Icon Data="{StaticResource Icon.Minimize}" Width="12" Height="12" StrokeThickness="1.2"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource Button.Caption}" Click="OnMaximize" ToolTip="Maximize">
                        <c:Icon Data="{StaticResource Icon.Maximize}" Width="11" Height="11" StrokeThickness="1.2"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource Button.CaptionClose}" Click="OnClose" ToolTip="Close to tray (Synapse keeps running)">
                        <c:Icon Data="{StaticResource Icon.Close}" Width="12" Height="12" StrokeThickness="1.2"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Page content -->
            <ContentControl Grid.Column="1" Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>
    </Border>
</Window>
